# Copy this file to .env and fill in your own keys. Never commit .env.

# fal.ai — image & video generation. Get a key at https://fal.ai/dashboard/keys
# Format is usually "id:secret"
FAL_KEY=

# Anthropic — Claude, used to enhance/expand rough prompts into detailed
# generation prompts. Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Claude model used for prompt enhancement. Haiku is fast & cheap, which
# fits a tight budget well. Swap to claude-sonnet-5 for higher quality.
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Hard monthly spend cap (USD) across image + video generation.
# The server refuses new generations once estimated spend crosses this.
MONTHLY_BUDGET_USD=30

# Optional but recommended for deployment: Upstash Redis (free tier) for
# tracking spend. Required on stateless hosts like Vercel — without these,
# budget tracking falls back to a local file that won't persist there.
# Get free credentials at https://console.upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Shorts pipeline (npm run short) ---

# ElevenLabs — narration in your own cloned voice, with word timestamps for
# captions. Key: https://elevenlabs.io/app/settings/api-keys
# Voice ID: https://elevenlabs.io/app/voice-lab (open your voice, copy its ID)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# eleven_flash_v2_5 is half the credits of multilingual_v2 and fine for shorts.
ELEVENLABS_MODEL=eleven_flash_v2_5
# Used by the budget guard: Creator plan is $22 per 100k credits, flash bills
# 0.5 credit per character, so ~$0.11 per 1,000 characters.
ELEVENLABS_USD_PER_1K_CHARS=0.11

# Pexels — free stock footage for phase-1 visuals. https://www.pexels.com/api/
PEXELS_API_KEY=

# Claude models for the pipeline. The script writer wants the stronger
# model; the story picker scores many candidates so it uses the cheap one.
PIPELINE_SCRIPT_MODEL=claude-sonnet-5
PIPELINE_PICKER_MODEL=claude-haiku-4-5-20251001

# Caption font (must be installed where ffmpeg runs). DejaVu Sans ships with
# most Linux images; on Windows try "Arial".
CAPTION_FONT=DejaVu Sans

# --- YouTube upload (npm run short -- upload) ---

# From a Google Cloud project with the YouTube Data API v3 enabled, and an
# OAuth client of type "Desktop app": console.cloud.google.com -> APIs &
# Services -> Credentials -> Create credentials -> OAuth client ID.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Get this by running `npm run youtube-auth` once (opens a browser, needs
# to run on a machine with one — not in a headless sandbox).
YOUTUBE_REFRESH_TOKEN=
